<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.celestia</groupId>
        <artifactId>celestia-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent</artifactId>

    <properties>
        <!-- SPEC-012 (T011, T012): Spring AI binds @Tool arguments by parameter
             name, and @ToolParam has no name attribute, so the names must survive
             compilation. Without -parameters every tool argument arrives null and
             the model's calls silently do nothing — which the stub-model tier
             catches and a real model would not explain. -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
    </properties>
    <name>Celestia Agent</name>
    <description>Spring Boot application: conversation orchestrator, FSMs, guarded LLM pipeline, persistence, wiring of all modules.</description>

    <dependencies>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>ephemeris</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>geo</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>guardrail</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>payments-razorpay</artifactId>
        </dependency>
        <dependency>
            <groupId>com.celestia</groupId>
            <artifactId>channel-whatsapp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- SPEC-008: persistence -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Boot 4.1 modularised autoconfig: the Flyway auto-configuration lives
             in its own module, not in spring-boot-autoconfigure. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- SPEC-012 (T001): the chat model. Versions from the parent's
             dependencyManagement (spring-ai-bom 2.0.1), so none here.
             Both providers are on the classpath and celestia.llm.provider picks
             one (ADR-0009, amended 2026-11-24): Ollama is the committed default
             so a clone with no credentials still builds and tests; the Claude API
             is the development story, because a small local model cannot drive
             eleven tool definitions at all. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>

        <!--
          Added per phase:
            Phase 7+ spring-boot-starter-security
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SPEC-009: Boot 4.1 split MockMvc's test autoconfiguration out of
             spring-boot-test-autoconfigure into this webmvc-specific module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 2.x renamed the modules: testcontainers-<name> -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SPEC-009: stubs the Graph API for the webhook/worker/sender ITs -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- SPEC-008: *IT classes are Testcontainers integration tests; they
                 run in the `verify` phase, not the fast `test` loop. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
